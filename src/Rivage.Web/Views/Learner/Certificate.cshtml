@model Certificate
@{
    ViewData["Title"] = "Certificat";
}
<div class="container section">
    <div class="panel" style="text-align:center;padding:2.5rem 1.5rem;border:2px solid var(--sea-mid)">
        <div class="brand" style="justify-content:center;margin-bottom:1rem">
            <span class="brand-mark"></span> Rivage
        </div>
        <h2>Certificat de réussite</h2>
        <p class="lede" style="margin:0 auto 1rem">Décerné à</p>
        <h3 style="font-family:var(--font-display);font-size:2rem;margin:0">@Model.LearnerName</h3>
        <p>pour la formation <strong>@Model.FormationTitle</strong></p>
        <p class="meta">Code @Model.Code · Émis le @Model.IssuedAt.ToLocalTime().ToString("dd/MM/yyyy")</p>
        <button class="btn btn-ghost" onclick="window.print()">Imprimer</button>
    </div>
</div>