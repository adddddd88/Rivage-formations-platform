@using System.Security.Claims
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] ?? "Rivage") — Formations</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,700&family=Manrope:wght@400;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/rivage.css" asp-append-version="true" />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Ccircle cx='32' cy='32' r='30' fill='%130b2e36'/%3E%3Cpath d='M8 40c10-8 18-4 24-10s12-2 24 8' stroke='%23e8f3f1' stroke-width='4' fill='none'/%3E%3C/svg%3E" />
</head>
<body>
<header class="site-header">
    <nav class="nav">
        <a class="brand" asp-controller="Home" asp-action="Index">
            <span class="brand-mark" aria-hidden="true"></span>
            Rivage
        </a>
        <div class="nav-links">
            <a asp-controller="Catalog" asp-action="Index">Catalogue</a>
            @if (User.Identity?.IsAuthenticated == true)
            {
                @if (User.IsInRole(AppRoles.Learner) || User.IsInRole(AppRoles.Admin))
                {
                    <a asp-controller="Learner" asp-action="Index">Mon parcours</a>
                }
                @if (User.IsInRole(AppRoles.Trainer) || User.IsInRole(AppRoles.Admin))
                {
                    <a asp-controller="Trainer" asp-action="Index">Espace formateur</a>
                }
                @if (User.IsInRole(AppRoles.Admin))
                {
                    <a href="/Admin">Administration</a>
                }
                <form asp-controller="Account" asp-action="Logout" method="post" style="display:inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-ghost btn-sm">Déconnexion</button>
                </form>
            }
            else
            {
                <a asp-controller="Account" asp-action="Login">Connexion</a>
                <a class="btn btn-primary btn-sm" asp-controller="Account" asp-action="Register">Créer un compte</a>
            }
        </div>
    </nav>
</header>

<main>
    @if (TempData["Success"] is string success)
    {
        <div class="container"><div class="alert alert-success">@success</div></div>
    }
    @if (TempData["Error"] is string error)
    {
        <div class="container"><div class="alert alert-error">@error</div></div>
    }
    @RenderBody()
</main>

<footer class="site-footer">
    <strong>Rivage</strong> — du rivage de la découverte au large de la maîtrise.
</footer>
<script src="~/js/rivage.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
