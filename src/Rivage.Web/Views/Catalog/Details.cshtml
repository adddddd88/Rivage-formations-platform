@model Formation
@{
    ViewData["Title"] = Model.Title;
}
<div class="container section">
    <span class="badge">@Model.Category.Name</span>
    <h2>@Model.Title</h2>
    <p class="lede">@Model.ShortDescription</p>
    <div class="grid grid-2">
        <div class="panel">
            <p>@Model.Description</p>
            <p class="meta">Niveau @Model.Level · @Model.DurationHours heures · @Model.Modules.Count modules</p>
            @if (Model.TrainerProfile?.User is not null)
            {
                <p><strong>Formateur :</strong> @Model.TrainerProfile.User.FullName — @Model.TrainerProfile.Specialty</p>
            }
            @if (User.Identity?.IsAuthenticated == true)
            {
                <form asp-controller="Learner" asp-action="Enroll" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="formationId" value="@Model.Id" />
                    <button class="btn btn-accent" type="submit">S'inscrire</button>
                </form>
            }
            else
            {
                <a class="btn btn-accent" asp-controller="Account" asp-action="Login">Connectez-vous pour vous inscrire</a>
            }
        </div>
        <div class="panel">
            <h3>Modules</h3>
            <ol>
                @foreach (var m in Model.Modules.OrderBy(x => x.OrderIndex))
                {
                    <li style="margin-bottom:.55rem">
                        <strong>@m.Title</strong>
                        <div class="meta">@m.ContentType · ~@m.EstimatedMinutes min</div>
                    </li>
                }
            </ol>
        </div>
    </div>
</div>